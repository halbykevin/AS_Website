# The marketing site's API — the same one as.com.lb reads. This app has no
# backend and no database of its own: events, categories and settings all come
# from here, filled by the events sync in the admin at as.com.lb/admin/scraper.
NEXT_PUBLIC_API_URL=https://asapi.as.com.lb

# Public origin of this app, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://ticketing.as.com.lb

# Google Analytics 4. Its own property, separate from as.com.lb and the store.
# Optional — the ID below is the default; set it here to point at a different
# property, or to '' to turn analytics off entirely.
NEXT_PUBLIC_GA_ID=G-GMR1JFMHQF
