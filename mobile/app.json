{
  "expo": {
    "name": "AS Company",
    "slug": "as-company-mobile",
    "scheme": "ascompany",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lb.com.as.company",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lb.com.as.company",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/as-logo-clear.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A41E22",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "websiteApiUrl": "https://asapi.as.com.lb",
      "storeApiUrl": "https://store-api.as.com.lb",
      "router": {},
      "eas": {
        "projectId": "d4b13079-b3bf-42e1-8edf-cb9aed914ec6"
      }
    },
    "owner": "ascompanylb1"
  }
}
