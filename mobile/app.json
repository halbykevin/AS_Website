{
  "expo": {
    "name": "AS Company",
    "slug": "as-company-mobile",
    "scheme": "ascompany",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lb.com.as.company"
    },
    "android": {
      "package": "lb.com.as.company",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A41E22"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#A41E22",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "websiteApiUrl": "https://asapi.as.com.lb",
      "storeApiUrl": "https://store-api.as.com.lb",
      "router": {},
      "eas": {
        "projectId": "40636c10-bbe0-4f53-8893-e31deedf3cda"
      }
    },
    "owner": "ascompany.lb4"
  }
}
