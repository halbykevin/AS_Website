{
  "name": "as-company-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AS Company mobile app — the AS Website (events + what we do) and AS Store (e-commerce) in one Expo app, sharing a single design system.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear --port 8082",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "lint": "expo lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:prod": "eas build --platform android --profile production-apk",
    "build:aab": "eas build --platform android --profile production",
    "build:dev": "eas build --platform android --profile development",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "credentials": "eas credentials",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "prettier": "^3.7.4"
  },
  "//overrides": "Force expo-font to the SDK 54 version. @expo/vector-icons declares expo-font as a peer (>=14.0.4), so npm otherwise auto-installs the latest (57.x, built for a newer expo-modules-core) which crashes release builds with NoSuchMethodError: getDirectConverter.",
  "overrides": {
    "expo-font": "$expo-font"
  }
}
