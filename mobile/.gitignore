# Expo / React Native
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
ios/
android/

# Metro
.metro-health-check*

# Env / local
.env
.env.*
!.env.example

# Misc
.DS_Store
npm-debug.*
yarn-error.*
*.log

# Local validation artifacts
.expo-export-check/
export.log

# APKs downloaded by scripts/apk.mjs — ~90 MB each, always re-fetchable from EAS.
build/

# FCM/APNs push SECRETS — never commit (uploaded to EAS credentials instead).
# NOTE: google-services.json / GoogleService-Info.plist are client configs that
# ship inside the app binary and (private repo) are tracked so EAS Build includes
# them — they are intentionally NOT ignored here.
*-service-account*.json
*-firebase-adminsdk-*.json
# GCP/Firebase service-account keys download as "<project>-<hash>.json".
as-company-lb-*.json
!google-services.json

# Android upload keystore backed up from EAS + its plaintext passwords.
# Losing these means Play Store can never accept a new build — keep an offline copy.
credentials/
credentials.json
