# AS Company mobile app — API base URLs.
#
# These override the defaults baked into app.json → expo.extra. Point them at
# the machine running the two Express APIs. On a physical device the two servers
# must be reachable from the phone, so use your computer's LAN IP (e.g.
# http://192.168.1.20:8080), NOT localhost — localhost on the phone is the phone.

# AS Website API (events, what-we-do, settings). Local dev: :8080
EXPO_PUBLIC_WEBSITE_API_URL=https://asapi.as.com.lb
# AS Store API (products, cart, orders, accounts). Local dev: :8081
EXPO_PUBLIC_STORE_API_URL=https://store-api.as.com.lb
 