# Managed by ASDesk (deploy/remote/provision.sh).
[Unit]
Description=ASDesk control API (rendezvous, signaling, TURN credentials)
After=network-online.target postgresql.service
Wants=network-online.target
# Keep retrying through long outages (e.g. PostgreSQL restarts); never give up on the service.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@BASE@/current
ExecStart=@NODE_BIN@ --enable-source-maps --env-file=@BASE@/shared/.env @BASE@/current/dist/server.mjs
Restart=always
RestartSec=2
# The API ends sessions and releases its database lock on SIGTERM; give it time to do so.
KillSignal=SIGTERM
TimeoutStopSec=15
LimitNOFILE=65536

# Sandbox: the service only needs to read its release and talk to PostgreSQL and nginx locally.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
