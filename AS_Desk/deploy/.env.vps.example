# =============================================================================
# ASDesk host profile. Copy to deploy/.env.vps (default host) or deploy/.env.vps.<name>
# for additional hosts; pick one with `npm run server:deploy -- --host <name>`.
# Profiles are gitignored. They hold no password: `npm run server:setup-ssh` installs a
# deploy key once (asking for the password), after which every command uses the key.
# =============================================================================

VPS_PROFILE_LABEL="production (203.0.113.10)"
VPS_HOST=203.0.113.10
VPS_USER=root
VPS_PORT=22
# Host key fingerprint, verified before anything is sent. Get it from your provider's
# console (`ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`). PuTTY's form also works.
VPS_HOSTKEY="SHA256:replace-with-the-host-fingerprint"
# Private key used for deploys (created by server:setup-ssh if missing).
SSH_KEY=~/.ssh/asdesk_deploy

# Public API name. Its DNS A record must point at VPS_HOST before provisioning.
API_DOMAIN=asdesk-api.example.com
# Local port for the API behind nginx; must be free on the host.
APP_PORT=4700
# TURN relay (coturn). Open these in any cloud firewall: TURN_PORT udp+tcp, TURNS_PORT tcp,
# and the relay range udp.
TURN_PORT=3478
TURNS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49660
# Optional Let's Encrypt contact for expiry notices. Leave empty to use the host's
# existing certbot account.
ACME_EMAIL=
# Who may register a computer. open: anyone who installs the app gets an ID, like AnyDesk;
# every connection still needs the person at the other computer to accept. token: only
# computers given the enrollment token (npm run server:token). Applied by server:provision.
ENROLLMENT=token
