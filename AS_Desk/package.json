{
  "name": "rAIdesk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch services/control-api/src/main.ts",
    "start": "tsx services/control-api/src/main.ts",
    "client": "tsx tools/dev-client.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test services/control-api/test/*.test.ts",
    "desktop:build": "node tools/build-desktop.mjs",
    "desktop:check": "tsc -p apps/desktop/tsconfig.json --noEmit",
    "desktop:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:debug": "node tools/desktop.mjs debug",
    "desktop:e2e": "tsx tools/desktop-e2e.ts",
    "desktop:package": "node tools/desktop.mjs package",
    "desktop:package:win7": "node tools/desktop.mjs package --win7",
    "desktop:release:win7": "node tools/desktop.mjs release --win7",
    "desktop:package:mac": "node tools/desktop.mjs package --mac",
    "desktop:release:mac": "node tools/desktop.mjs release --mac",
    "desktop:publish": "node deploy/wrapper.cjs publish-desktop",
    "server:build": "node tools/build-server.mjs",
    "server:smoke": "node tools/build-server.mjs && node tools/server-smoke.mjs",
    "server:setup-ssh": "node deploy/wrapper.cjs setup-ssh",
    "server:provision": "node deploy/wrapper.cjs provision",
    "server:deploy": "node deploy/wrapper.cjs deploy",
    "server:status": "node deploy/wrapper.cjs status",
    "server:logs": "node deploy/wrapper.cjs logs",
    "server:rollback": "node deploy/wrapper.cjs rollback",
    "server:token": "node deploy/wrapper.cjs token",
    "server:admin": "node deploy/wrapper.cjs admin",
    "server:backup": "node deploy/wrapper.cjs backup",
    "website:dev": "npm --prefix apps/website run dev",
    "website:build": "npm --prefix apps/website run build",
    "website:preview": "npm --prefix apps/website run preview",
    "website:publish": "node tools/publish-website-release.mjs",
    "db:migrate": "tsx services/control-api/src/migrate.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.2.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "ws": "8.21.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "prettier": "^3.7.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
