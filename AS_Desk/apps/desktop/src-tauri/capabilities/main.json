{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The app's own UI. It can only reach the agent's commands, its events and window dragging.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-state",
    "allow-setup",
    "allow-connect",
    "allow-forget",
    "allow-rename-recent",
    "allow-dismiss-error",
    "allow-accept",
    "allow-reject",
    "allow-cancel",
    "allow-disconnect",
    "allow-signal",
    "allow-input",
    "allow-block-input",
    "allow-prove-password",
    "allow-read-clipboard",
    "allow-set-unattended",
    "allow-clear-unattended",
    "allow-copy-id",
    "allow-window-action",
    "allow-probe-display",
    "allow-report",
    "allow-clipboard-files",
    "allow-file-read",
    "allow-file-recv-begin",
    "allow-file-recv-open",
    "allow-file-recv-chunk",
    "allow-file-recv-finish",
    "allow-file-cancel"
  ]
}
