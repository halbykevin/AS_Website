{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASDesk",
  "mainBinaryName": "ASDesk",
  "version": "../package.json",
  "identifier": "com.companyremote.desktop",
  "build": {
    "frontendDist": "../dist/ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "headers": {
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "rAIone",
    "shortDescription": "Remote Desktop App",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 165, "y": 175 },
        "applicationFolderPosition": { "x": 435, "y": 175 }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma",
        "template": "windows/installer.nsi"
      }
    }
  }
}
