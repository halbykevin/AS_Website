{
  "name": "as-store",
  "private": true,
  "version": "0.1.0",
  "description": "AS Store — e-commerce storefront for AS Company (Absolute Solutions SAL). Next.js + Tailwind + Redux + React Query.",
  "scripts": {
    "dev": "next dev -p 5180",
    "build": "next build",
    "start": "next start -p 5180",
    "lint": "next lint",
    "ship": "node scripts/ship.mjs",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "check-feed": "node scripts/check-merchant-feed.mjs",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/*.test.js",
    "deploy:store": "node ../scripts/deploy.mjs --app store"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/react-query": "^5.59.0",
    "framer-motion": "^11.11.17",
    "next": "^15.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "not dead"
  ]
}
