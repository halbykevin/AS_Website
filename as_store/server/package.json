{
  "name": "as-store-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AS Store backend API (Express + PostgreSQL)",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "clean": "node src/cleanup.js",
    "deploy": "node ../../scripts/deploy.mjs --app store",
    "deploy:all": "node ../../scripts/deploy.mjs",
    "backfill-images": "node src/backfill-images.js",
    "import-scrape": "node src/import-scrape.js",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1"
  }
}
