# AS Store API configuration. Copy to .env and keep the real file out of Git.
DATABASE_URL=postgres://as_store_user:change-me@127.0.0.1:5432/as_store
PORT=8081
PUBLIC_URL=http://localhost:8081
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5180,http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Order emails -----------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=orders@example.com
SMTP_PASS=replace-with-mailbox-password
ORDERS_NOTIFY_TO=orders@example.com
STORE_URL=http://localhost:5180

# --- WhatsApp OTP -----------------------------------------------------------
WHATSAPP_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token
WHATSAPP_2FA_PIN=replace-with-meta-two-step-pin

# --- Google sign-in ---------------------------------------------------------
# Production must use the exact HTTPS callback registered on the Web OAuth
# client, for example:
# GOOGLE_REDIRECT_URI=https://store-api.example.com/api/account/google/callback
GOOGLE_CLIENT_ID=replace-with-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-web-oauth-client-secret

# --- App Review demo account -------------------------------------------------
# Lets an App Store / Play reviewer sign in without receiving our one-time code.
# Set both and that ONE email address accepts the fixed code below, is never
# sent anything, and skips the request rate limit; everything else is untouched.
# REVIEW_CODE must be EXACTLY 6 digits — the app's code field accepts nothing
# else — so it carries a per-IP attempt cap instead of length. Unset both once
# the app is approved; the server logs a warning at boot while they are live.
# REVIEW_EMAIL=appreview@as.com.lb
# REVIEW_CODE=481903

# --- Sign in with Apple ------------------------------------------------------
# Signing in needs none of this: the default bundle id below is what an identity
# token's `aud` is checked against, and that is the whole verification. Set
# APPLE_BUNDLE_ID only if the app's id changes, or comma-separate several.
# APPLE_BUNDLE_ID=lb.com.as.store
#
# The WEBSITE's "Continue with Apple" needs a Services ID — a separate identifier
# from the app's, made at developer.apple.com → Identifiers → Services IDs, with
# Sign in with Apple enabled and grouped under the app's App ID (lb.com.as.store).
# Its "Return URLs" must list the callback below exactly; its domain list must
# include the API's host. Unset = the website shows no Apple button; the app is
# unaffected either way. The redirect defaults to PUBLIC_URL + the path below
# and must be https — Apple never returns a browser to http or localhost.
# APPLE_SERVICES_ID=lb.com.as.store.web
# APPLE_REDIRECT_URI=https://store-api.as.com.lb/api/account/apple/callback
#
# The three below enable *revocation* — telling Apple to withdraw the grant when
# a customer deletes their account, which Apple requires of an app that offers
# both. Without them sign-in still works and deletion still deletes; we simply
# cannot inform Apple. Create a "Sign in with Apple" key in the developer portal
# and paste the .p8 contents as one line with \n for the newlines.
# APPLE_TEAM_ID=replace-with-10-char-team-id
# APPLE_KEY_ID=replace-with-key-id
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"

# --- Whish Pay --------------------------------------------------------------
# Sandbox:
WHISH_BASE_URL=https://partner.api.sbx.whish.money/itel-service/api
# Production: https://api.whish.money/itel-service/api
WHISH_CHANNEL=replace-with-whish-channel
WHISH_SECRET=replace-with-whish-secret
# Use the exact app/site identifier issued by Whish.
WHISH_WEBSITE_URL=https://store.example.com
WHISH_USER_AGENT=AS-Store/1.0 (https://store.example.com; orders@example.com)

# All four Whish callback/redirect URLs must be public HTTPS URLs. Online
# payment stays hidden while either base below is localhost or non-HTTPS.
PUBLIC_API_URL=https://store-api.example.com
STORE_PUBLIC_URL=https://store.example.com

# Production: keep only the scheme owned by the shipped app. For Expo Go local
# testing, explicitly append exp,exps in the uncommitted .env.
APP_RETURN_SCHEMES=ascompany

# --- Notifications ----------------------------------------------------------
# EXPO_ACCESS_TOKEN=
# NOTIFY_WORKER_INTERVAL_MS=15000
# NOTIFY_WORKER_DISABLED=
