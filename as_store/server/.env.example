# --- Database (PostgreSQL) ---
# The AS Store database (separate from the marketing site's as_company).
DATABASE_URL=postgres://as_user:change-me@127.0.0.1:5432/as_store

# --- Server ---
PORT=8081
# Public base URL of THIS api (used to build uploaded image URLs). No trailing slash.
PUBLIC_URL=http://localhost:8081
# Where uploaded images are stored on disk.
UPLOAD_DIR=./uploads

# --- CORS ---
# Comma-separated allowed origins. The storefront (5180) and the admin (5173).
CORS_ORIGIN=http://localhost:5180,http://localhost:5173

# --- Admin login + tokens ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- Order emails (optional; mails are skipped when unset) ---
# SMTP over SSL (port 465) — e.g. the company mailbox orders@as.com.lb.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=orders@example.com
SMTP_PASS=the-mailbox-password
# Where new-order notification copies go (defaults to SMTP_USER).
ORDERS_NOTIFY_TO=orders@example.com
# Storefront base URL used in the "Track your order" email link.
STORE_URL=http://localhost:5180

# --- Login OTP ---
# Shoppers pick a channel on the sign-in page. Email works whenever SMTP above is
# set; WhatsApp only appears once all three WHATSAPP_* values below are filled.
# Echo the code in the API response for local testing. NEVER in production.
OTP_DEV_ECHO=1

# --- WhatsApp sign-in codes (optional; the channel is hidden when unset) ---
# Meta Cloud API. Leave blank and the login page offers email only — codes are
# written to the server log instead, like the mailer does in dev.
#
# WHATSAPP_OTP_TEMPLATE must name an AUTHENTICATION-category template approved on
# the SAME WhatsApp Business Account as WHATSAPP_PHONE_ID (templates don't cross
# WABAs), created with an OTP button of type COPY_CODE.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=
# Template language code, and the Graph API version to call.
WHATSAPP_LANG=en
WHATSAPP_GRAPH_VERSION=v21.0

# --- WhatsApp webhook (needed to REGISTER a phone number) -------------------
# Meta won't let an app register a number on a WABA unless the app is subscribed
# to that WABA's webhooks, and a subscription needs a public HTTPS callback that
# answers the verification handshake. The OTP flow itself never listens — but
# the endpoint also gives us delivery receipts and customer replies (logged).
#
# Callback URL to paste into the app dashboard:
#   https://store-api.as.com.lb/api/whatsapp/webhook
# A string you invent; it must match the "Verify token" field in the dashboard.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings → Basic). Optional: when set, incoming webhook
# deliveries are rejected unless Meta's X-Hub-Signature-256 matches.
WHATSAPP_APP_SECRET=
