# --- Database (PostgreSQL) ---
# The AS Store database (separate from the marketing site's as_company).
DATABASE_URL=postgres://as_user:change-me@127.0.0.1:5432/as_store

# --- Server ---
PORT=8081
# Public base URL of THIS api (used to build uploaded image URLs). No trailing slash.
PUBLIC_URL=http://localhost:8081
# Where uploaded images are stored on disk.
UPLOAD_DIR=./uploads

# --- CORS ---
# Comma-separated allowed origins. The storefront (5180) and the admin (5173).
CORS_ORIGIN=http://localhost:5180,http://localhost:5173

# --- Admin login + tokens ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- Order emails (optional; mails are skipped when unset) ---
# SMTP over SSL (port 465) — e.g. the company mailbox orders@as.com.lb.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=orders@example.com
SMTP_PASS=the-mailbox-password
# Where new-order notification copies go (defaults to SMTP_USER).
ORDERS_NOTIFY_TO=orders@example.com
# Storefront base URL used in the "Track your order" email link.
STORE_URL=http://localhost:5180

# --- Login OTP (delivery channel not wired yet; codes are logged) ---
# Echo the code in the API response for local testing. NEVER in production.
OTP_DEV_ECHO=1
