WHISH_CHANNEL=10201046
WHISH_SECRET=33169358907f421dafb3778c0814c6cd
WHISH_WEBSITE_URL=store.as.com.lb
# Public base URLs Whish calls/redirects to. Default to the local API/store, but
# Whish rejects localhost — set these to a tunnel (cloudflared/ngrok) or the real
# domains when exercising the payment flow.
PUBLIC_API_URL=http://localhost:8081
STORE_PUBLIC_URL=http://localhost:5180
# Custom URL schemes the mobile app may be handed back to after paying
# (/api/orders/whish/return deep-links into the app). Anything not listed here is
# refused, so this can't become an open redirect. Drop `exp,exps` — Expo Go during
# development — once the app ships as a build.
APP_RETURN_SCHEMES=ascompany,exp,exps
