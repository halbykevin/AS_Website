{
  "name": "as-company-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "//app": "The Android release, from the repo root: builds the Play Store bundle on EAS, downloads it to mobile/build/ and opens that folder to drag into Play Console. `app -- --latest` skips the build and fetches the newest finished one. See mobile/scripts/apk.mjs.",
    "app": "npm --prefix mobile run aab --",
    "app:test": "npm --prefix mobile run apk --",
    "kill": "node scripts/kill-dev.mjs",
    "kill:dry": "node scripts/kill-dev.mjs --dry",
    "deploy": "node scripts/deploy.mjs",
    "deploy:site": "node scripts/deploy.mjs --app site",
    "deploy:store": "node scripts/deploy.mjs --app store",
    "deploy:setup": "node scripts/deploy.mjs --remote --setup"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.3"
  }
}
