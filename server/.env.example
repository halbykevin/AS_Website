# AS Company website API. Copy to .env; never commit real credentials.
DATABASE_URL=postgres://as_user:change-me@127.0.0.1:5432/as_company
PORT=8080
PUBLIC_URL=http://localhost:8080
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- AS Store API (the homepage store banner reads its catalog) -------------
# The banner shows real AS Store products, fetched server-to-server from the
# store's own API. Local dev: the store API on this machine. On the VPS both
# APIs run side by side, so point it at the loopback port from
# as_store/server/.env — currently http://127.0.0.1:10001, NOT 8081.
# Unset/unreachable = the homepage panel falls back to the AS Store logo.
STORE_API_URL=http://localhost:8081

# --- Seat maps (ticketing hub) ----------------------------------------------
# The hub's event pages show a live seat map for events sold by Ticketing Box
# Office, ihjoz, Tick'it or Antoine Ticketing, read from the partner's own page
# on demand. Set to 0
# to turn every seat map off — the pages fall back to the plain "Reserve on
# WhatsApp" button.
# SEATMAP_ENABLED=0
#
# Turn off one source without turning off the rest (comma-separated allow-list
# of the ones to KEEP): tbo, ihjoz, tickit, antoineticketing. Unset = all four.
# SEATMAP_SOURCES=tbo,ihjoz

# --- Pre-rendered site rebuilds ----------------------------------------------
# as.com.lb's public pages are static HTML rendered at build time from this API.
# Paste the marketing-site project's Vercel Deploy Hook here (Settings -> Git ->
# Deploy Hooks) and admin edits to that content trigger a rebuild. Unset = off:
# visitors still see fresh content, crawlers see it after the next deploy.
# SITE_REBUILD_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy
# SITE_REBUILD_DELAY_SECONDS=120
# SITE_REBUILD_EVERY_HOURS=24

# Tell the ticketing hub to refresh the moment an event is published or edited
# (src/hubRevalidate.js). The secret must equal REVALIDATE_SECRET on the hub's
# Vercel project. Unset = the hub catches up within its 5-minute cache.
# HUB_REVALIDATE_URL=https://ticketing.as.com.lb/api/revalidate
# HUB_REVALIDATE_SECRET=

# Ticket bookings on AS-hosted events (src/bookings.js). "Buy now" pays with
# Whish — the same merchant account as the AS Store, so copy the WHISH_* values
# from as_store/server/.env. Unset = bookings still work, cash at AS Company only.
# Whish also needs PUBLIC_URL and TICKETING_PUBLIC_URL to be public https.
# WHISH_BASE_URL=https://api.whish.money/itel-service/api
# WHISH_CHANNEL=
# WHISH_SECRET=
# WHISH_WEBSITE_URL=store.as.com.lb
# Where booking links and redirects point (defaults shown).
# TICKETING_PUBLIC_URL=https://ticketing.as.com.lb
# ADMIN_PUBLIC_URL=https://www.as.com.lb

# Optional scraper paths.
# PYTHON_BIN=python3
# SCRAPER_DIR=../WebScarping
# SCRAPE_DIR=./scrapes

# --- WhatsApp predictor confirmation ---------------------------------------
WHATSAPP_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_ID=replace-with-phone-number-id
WHATSAPP_TEMPLATE=predictions_confirmed
WHATSAPP_LANG=en
WHATSAPP_DEFAULT_CC=961
WHATSAPP_GRAPH_VERSION=v21.0

# --- Tickets on WhatsApp (src/ticketsWhatsApp.js) ---------------------------
# A paid booking's customer gets their tickets PDF on WhatsApp, from the number
# above. Submit the template once with `npm run whatsapp:tickets-template`
# (needs the WABA id), then set its name here once Meta approves it.
# Unset = off: tickets still go by email and the booking page.
# WHATSAPP_WABA_ID=
# WHATSAPP_TICKETS_TEMPLATE=tickets_confirmed
# WHATSAPP_TICKETS_LANG=en

# --- Email notifications (predictor entries + contact form) ------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-mailbox-password
MAIL_FROM=AS Company <notifications@example.com>
PREDICTOR_NOTIFY_TO=admin@example.com
# Where /contact messages are emailed. Defaults to orders@as.com.lb in code, so
# this only needs setting to send them somewhere else.
CONTACT_NOTIFY_TO=orders@as.com.lb
