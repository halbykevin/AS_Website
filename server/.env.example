# --- Database (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev: matches the as_user / as_company DB you create (see commands below).
# If you later use the VPS/online DB instead, paste its connection string here.
DATABASE_URL=postgres://as_user:as_company_pw@127.0.0.1:5432/as_company

# --- Server ---
PORT=8080
# Public base URL of THIS api (used to build image URLs). No trailing slash.
# Local: http://localhost:8080   Production: https://api.yourdomain.com
PUBLIC_URL=http://localhost:8080
# Where uploaded images are stored on disk (absolute path recommended in prod).
UPLOAD_DIR=./uploads

# --- CORS ---
# Comma-separated list of allowed website origins. Use * only for local testing.
# Production example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=*

# --- Admin login + tokens ---
ADMIN_EMAIL=kevinhalby70199@gmail.com
ADMIN_PASSWORD=Dune!23$
# Long random string used to sign login tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=8a0bee9445ef46ceea1c8d3c620e004dab6283c71bf5afcc9a5533312fe9709a23c20bae5c1f4c824c2855380b7c83b7

# --- Web scraper (admin /api/scrape) ---
# The API spawns the Python scraper in WebScarping/. Requires Python 3 +
# `pip install -r WebScarping/requirements.txt` on the host.
# Override only if the defaults don't fit your VPS layout.
# PYTHON_BIN=python3
# SCRAPER_DIR=../WebScarping        # path to the Python scraper (relative to server/src)
# SCRAPE_DIR=./scrapes              # where per-run output is written (runtime-only)

