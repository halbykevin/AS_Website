# AS Company website API. Copy to .env; never commit real credentials.
DATABASE_URL=postgres://as_user:change-me@127.0.0.1:5432/as_company
PORT=8080
PUBLIC_URL=http://localhost:8080
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- AS Store API (the homepage store banner reads its catalog) -------------
# The banner shows real AS Store products, fetched server-to-server from the
# store's own API. Local dev: the store API on this machine. On the VPS both
# APIs run side by side, so point it at the loopback port from
# as_store/server/.env — currently http://127.0.0.1:10001, NOT 8081.
# Unset/unreachable = the homepage panel falls back to the AS Store logo.
STORE_API_URL=http://localhost:8081

# --- Seat maps (ticketing hub) ----------------------------------------------
# The hub's event pages show a live seat map for events sold by Ticketing Box
# Office, ihjoz or Tick'it, read from the partner's own page on demand. Set to 0
# to turn every seat map off — the pages fall back to the plain "Reserve on
# WhatsApp" button.
# SEATMAP_ENABLED=0
#
# Turn off one source without turning off the rest (comma-separated allow-list
# of the ones to KEEP): tbo, ihjoz, tickit. Unset = all three.
# SEATMAP_SOURCES=tbo,ihjoz

# Optional scraper paths.
# PYTHON_BIN=python3
# SCRAPER_DIR=../WebScarping
# SCRAPE_DIR=./scrapes

# --- WhatsApp predictor confirmation ---------------------------------------
WHATSAPP_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_ID=replace-with-phone-number-id
WHATSAPP_TEMPLATE=predictions_confirmed
WHATSAPP_LANG=en
WHATSAPP_DEFAULT_CC=961
WHATSAPP_GRAPH_VERSION=v21.0

# --- Email notifications (predictor entries + contact form) ------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-mailbox-password
MAIL_FROM=AS Company <notifications@example.com>
PREDICTOR_NOTIFY_TO=admin@example.com
# Where /contact messages are emailed. Defaults to orders@as.com.lb in code, so
# this only needs setting to send them somewhere else.
CONTACT_NOTIFY_TO=orders@as.com.lb
