# --- Database (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://as_user:change-me@127.0.0.1:5432/as_company

# --- Server ---
PORT=8080
# Public base URL of THIS api (used to build image URLs). No trailing slash.
# Local: http://localhost:8080   Production: https://api.yourdomain.com
PUBLIC_URL=http://localhost:8080
# Where uploaded images are stored on disk (absolute path recommended in prod).
UPLOAD_DIR=./uploads

# --- CORS ---
# Comma-separated list of allowed website origins. Use * only for local testing.
# Production example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=*

# --- Admin login + tokens ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# Long random string used to sign login tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
