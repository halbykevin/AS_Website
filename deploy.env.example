# AS Company — deploy target for `npm run deploy` (deploy.ps1).
# Copy to deploy.env, or just run `npm run deploy` once and it will ask,
# then write the answers here for you. Never contains a password.

DEPLOY_HOST=95.217.2.105
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/as-company
# Windows path to the private key used for the deploy (created if missing).
DEPLOY_KEY=C:\Users\YOU\.ssh\id_ed25519
